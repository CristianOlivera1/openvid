# Supabase (required for authentication and the email API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional media search providers
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: authenticated GitHub API requests and Google Analytics
GITHUB_TOKEN=
NEXT_PUBLIC_GA_ID=

# Email API / scheduled email route
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CRON_SECRET=

# Optional email settings (defaults are provided by the app)
EMAIL_BATCH_SIZE=90
RESEND_FROM_EMAIL="Openvid <hi@openvid.dev>"
RESEND_REPLY_TO=
